# ─── Kartex Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in your values before running docker compose.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (used by Prisma)
# For docker-compose deployments: host is the service name (db)
DATABASE_URL=postgresql://kartex:changeme@db:5432/kartex

# ─── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — must be a long random string (at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret

# ─── Admin Seed ───────────────────────────────────────────────────────────────
# Initial admin account credentials (created on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The origin from which the browser makes requests to the API.
# In production: your full domain (e.g. https://kartex.example.com)
# In development: the Vite dev server origin
ALLOWED_ORIGIN=http://localhost:3000

# ─── Network ──────────────────────────────────────────────────────────────────
# Host port for the backend container (default 3000)
BACKEND_PORT=3000

# ─── Media Storage ────────────────────────────────────────────────────────────
# Absolute path inside the container where uploaded media files are stored.
# Mapped to a Docker volume in docker-compose.yml — do not change without
# also updating the volume mount path.
STORAGE_PATH=/app/media

# Maximum upload file size in bytes (default: 10 MB)
MAX_UPLOAD_BYTES=10485760
