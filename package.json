{
  "name": "kartex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "packageManager": "yarn@4.15.0",
  "scripts": {
    "dev:frontend": "yarn workspace @kartex/frontend dev",
    "dev:backend": "yarn workspace @kartex/backend dev",
    "build": "yarn workspaces foreach -A run build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "eslint 'apps/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'apps/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'apps/**/*.{ts,tsx,css}' 'packages/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'apps/**/*.{ts,tsx,css}' 'packages/**/*.{ts,tsx}'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.0"
  }
}
